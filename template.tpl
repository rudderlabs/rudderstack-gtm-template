___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// RudderStack tag template for Google Tag Manager.
//
// This is GTM sandboxed JavaScript, not JavaScript: there is no eval, no
// Function, no window, no document, no DOM and no network access. Everything
// reaches the page through the APIs required below, and GTM validates every
// key path handed to callInWindow / copyFromWindow / setInWindow against the
// literal allowlist in ___WEB_PERMISSIONS___ at runtime. Key paths are
// therefore spelled out literally rather than composed at runtime, so that the
// test harness can prove statically that each one is declared.

const log = require('logToConsole');
const getType = require('getType');
const Object = require('Object');
const makeNumber = require('makeNumber');
const makeTableMap = require('makeTableMap');
const callInWindow = require('callInWindow');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const injectScript = require('injectScript');

// The SDK's global object. access_globals key paths have to be literal strings
// in the permission manifest, so a configurable global name is not possible.
const GLOBAL_NAME = 'rudderanalytics';

// The CDN-hosted loader used by Call = load.
//
// WARNING: this artifact is NOT YET PUBLISHED. It has to be built and released
// from the rudder-sdk-js monorepo (packages/loading-scripts, which today emits
// a snippet with __WRITE_KEY__ / __DATAPLANE_URL__ placeholders baked in)
// before Call = load can be released to the Gallery. Everything else in this
// template works without it. To point at a different artifact, change this one
// constant and the matching inject_script entry in ___WEB_PERMISSIONS___.
const LOADER_URL = 'https://cdn.rudderlabs.com/js-sdk-loader-scripts/latest/loader-gtm.min.js';

const LOADER_CACHE_TOKEN = 'rsa-loader';
const LOG_PREFIX = 'RudderStack GTM template: ';

/**
 * Reports a failure. GTM Preview showing "Fired" while nothing left the browser
 * is what made the original customer escalation so hard to debug, so every path
 * that does not dispatch a call ends up here.
 */
function fail(reason) {
  log(LOG_PREFIX + reason);
  data.gtmOnFailure();
}

function isFilled(value) {
  return value !== undefined && value !== null && value !== '';
}

function isObject(value) {
  return getType(value) === 'object';
}

/** Shallow-merges source over target. Anything that is not an object is ignored. */
function merge(target, source) {
  if (!isObject(source)) {
    return target;
  }
  const keys = Object.keys(source);
  for (var i = 0; i < keys.length; i++) {
    target[keys[i]] = source[keys[i]];
  }
  return target;
}

/**
 * Drops trailing undefined arguments. v3 resolves overloads by inspecting
 * argument types, so a trailing undefined is at best noise and a leading one
 * shifts every later argument into the wrong slot.
 */
function truncate(args) {
  var last = -1;
  for (var i = 0; i < args.length; i++) {
    if (args[i] !== undefined) {
      last = i;
    }
  }
  const out = [];
  for (var j = 0; j <= last; j++) {
    out.push(args[j]);
  }
  return out;
}

/**
 * Properties or traits, lowest precedence first: the shared default variable,
 * then anything the call itself derives (the Object-Action keys), then this
 * tag's own table. Custom wins, which is a deliberate reversal of the 2022
 * behaviour. An absent or non-object Default properties variable contributes
 * nothing at all - it no longer synthesises a defaultProp / defaultTrait key.
 */
function buildProperties(derived) {
  const properties = {};
  merge(properties, data.defaultProperties);
  merge(properties, derived);
  merge(properties, makeTableMap(data.customProperties || [], 'key', 'value'));
  return properties;
}

/**
 * The options argument. The deprecated suppressGa toggle sits underneath the
 * Options variable, so an explicit Options always wins. Returns undefined when
 * there is nothing to send, so the argument gets truncated rather than passed.
 */
function buildOptions() {
  const options = {};
  if (data.suppressGa === true || data.suppressGa === 'true') {
    options.integrations = { All: true, 'Google Analytics': false };
  }
  merge(options, data.eventOptions);
  if (Object.keys(options).length === 0) {
    return undefined;
