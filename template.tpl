    runCode({call: 'teleport'});

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: Track without an event name reports failure
  code: |-
    mock('copyFromWindow', {});

    runCode({call: 'track'});

    assertApi('gtmOnFailure').wasCalled();
    assertApi('gtmOnSuccess').wasNotCalled();
- name: An empty Default properties variable injects no junk key
