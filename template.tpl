___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// RudderStack tag template for Google Tag Manager.
//
// This is GTM sandboxed JavaScript, not JavaScript: there is no eval, no
// Function, no window, no document, no DOM and no network access. Everything
// reaches the page through the APIs required below, and GTM validates every
// key path handed to callInWindow / copyFromWindow / setInWindow against the
// literal allowlist in ___WEB_PERMISSIONS___ at runtime. Key paths are
// therefore spelled out literally rather than composed at runtime, so that the
// test harness can prove statically that each one is declared.

const log = require('logToConsole');
const getType = require('getType');
const Object = require('Object');
const makeNumber = require('makeNumber');
const makeTableMap = require('makeTableMap');
const callInWindow = require('callInWindow');
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const injectScript = require('injectScript');

// The SDK's global object. access_globals key paths have to be literal strings
// in the permission manifest, so a configurable global name is not possible.
const GLOBAL_NAME = 'rudderanalytics';

// The CDN-hosted loader used by Call = load.
//
// WARNING: this artifact is NOT YET PUBLISHED. It has to be built and released
// from the rudder-sdk-js monorepo (packages/loading-scripts, which today emits
// a snippet with __WRITE_KEY__ / __DATAPLANE_URL__ placeholders baked in)
// before Call = load can be released to the Gallery. Everything else in this
// template works without it. To point at a different artifact, change this one
// constant and the matching inject_script entry in ___WEB_PERMISSIONS___.
const LOADER_URL = 'https://cdn.rudderlabs.com/v3/loader.min.js';

const LOADER_CACHE_TOKEN = 'rsa-loader';
const LOG_PREFIX = 'RudderStack GTM template: ';

/**
 * Reports a failure. GTM Preview showing "Fired" while nothing left the browser
 * is what made the original customer escalation so hard to debug, so every path
 * that does not dispatch a call ends up here.
 */
function fail(reason) {
  log(LOG_PREFIX + reason);
  data.gtmOnFailure();
}

function isFilled(value) {
  return value !== undefined && value !== null && value !== '';
}

function isObject(value) {
  return getType(value) === 'object';
}

/** Shallow-merges source over target. Anything that is not an object is ignored. */
function merge(target, source) {
  if (!isObject(source)) {
    return target;
  }
  const keys = Object.keys(source);
  for (var i = 0; i < keys.length; i++) {
    target[keys[i]] = source[keys[i]];
  }
  return target;
}

/**
 * Drops trailing undefined arguments. v3 resolves overloads by inspecting
 * argument types, so a trailing undefined is at best noise and a leading one
 * shifts every later argument into the wrong slot.
 */
function truncate(args) {
  var last = -1;
  for (var i = 0; i < args.length; i++) {
    if (args[i] !== undefined) {
      last = i;
    }
  }
  const out = [];
  for (var j = 0; j <= last; j++) {
    out.push(args[j]);
  }
  return out;
}

/**
 * Properties or traits, lowest precedence first: the shared default variable,
 * then anything the call itself derives (the Object-Action keys), then this
 * tag's own table. Custom wins, which is a deliberate reversal of the 2022
 * behaviour. An absent or non-object Default properties variable contributes
 * nothing at all - it no longer synthesises a defaultProp / defaultTrait key.
 */
function buildProperties(derived) {
  const properties = {};
  merge(properties, data.defaultProperties);
  merge(properties, derived);
  merge(properties, makeTableMap(data.customProperties || [], 'key', 'value'));
  return properties;
}

/**
 * The options argument. The deprecated suppressGa toggle sits underneath the
 * Options variable, so an explicit Options always wins. Returns undefined when
 * there is nothing to send, so the argument gets truncated rather than passed.
 */
function buildOptions() {
  const options = {};
  if (data.suppressGa === true || data.suppressGa === 'true') {
    options.integrations = { All: true, 'Google Analytics': false };
  }
  merge(options, data.eventOptions);
  if (Object.keys(options).length === 0) {
    return undefined;
  }
  return options;
}

/** 'absent', 'buffer' (the pre-load array) or 'loaded' (the SDK instance). */
function globalState() {
  const current = copyFromWindow(GLOBAL_NAME);
  const type = getType(current);
  if (type === 'undefined' || type === 'null') {
    return 'absent';
  }
  if (type === 'array') {
    return 'buffer';
  }
  return 'loaded';
}

/**
 * Pushes onto the SDK's pre-load buffer. This is a real dispatch, not a
 * fallback: triggerBufferedLoadEvent replays the array and
 * consumePreloadBufferedEvent's default branch forwards any method on it.
 */
function bufferCall(method, args) {
  const entry = [method];
  for (var i = 0; i < args.length; i++) {
    entry.push(args[i]);
  }
  callInWindow('rudderanalytics.push', entry);
}

/**
 * Calls the loaded SDK. Every key path below is a literal string so it can be
 * cross-checked against ___WEB_PERMISSIONS___ statically; GTM validates the
 * resolved value against the same allowlist at runtime.
 */
function directCall(method, args) {
  const n = args.length;

  if (method === 'page') {
    if (n === 1) {
      callInWindow('rudderanalytics.page', args[0]);
    } else if (n === 2) {
      callInWindow('rudderanalytics.page', args[0], args[1]);
    } else if (n === 3) {
      callInWindow('rudderanalytics.page', args[0], args[1], args[2]);
    } else {
      callInWindow('rudderanalytics.page', args[0], args[1], args[2], args[3]);
    }
  } else if (method === 'track') {
    if (n === 2) {
      callInWindow('rudderanalytics.track', args[0], args[1]);
    } else {
      callInWindow('rudderanalytics.track', args[0], args[1], args[2]);
    }
  } else if (method === 'identify') {
    if (n === 1) {
      callInWindow('rudderanalytics.identify', args[0]);
    } else if (n === 2) {
      callInWindow('rudderanalytics.identify', args[0], args[1]);
    } else {
      callInWindow('rudderanalytics.identify', args[0], args[1], args[2]);
    }
  } else if (method === 'group') {
    if (n === 1) {
      callInWindow('rudderanalytics.group', args[0]);
    } else if (n === 2) {
      callInWindow('rudderanalytics.group', args[0], args[1]);
    } else {
      callInWindow('rudderanalytics.group', args[0], args[1], args[2]);
    }
  } else if (method === 'alias') {
    if (n === 1) {
      callInWindow('rudderanalytics.alias', args[0]);
    } else if (n === 2) {
      callInWindow('rudderanalytics.alias', args[0], args[1]);
    } else {
      callInWindow('rudderanalytics.alias', args[0], args[1], args[2]);
    }
  } else if (method === 'load') {
    if (n === 2) {
      callInWindow('rudderanalytics.load', args[0], args[1]);
    } else {
      callInWindow('rudderanalytics.load', args[0], args[1], args[2]);
    }
  } else if (method === 'reset') {
    callInWindow('rudderanalytics.reset', args[0]);
  } else if (method === 'consent') {
    if (n === 0) {
      callInWindow('rudderanalytics.consent');
    } else {
      callInWindow('rudderanalytics.consent', args[0]);
    }
  } else if (method === 'startSession') {
    if (n === 0) {
      callInWindow('rudderanalytics.startSession');
    } else {
      callInWindow('rudderanalytics.startSession', args[0]);
    }
  } else if (method === 'endSession') {
    callInWindow('rudderanalytics.endSession');
  } else if (method === 'setAnonymousId') {
    callInWindow('rudderanalytics.setAnonymousId', args[0]);
  } else if (method === 'setCustomContext') {
    callInWindow('rudderanalytics.setCustomContext', args[0]);
  } else if (method === 'clearCustomContext') {
    callInWindow('rudderanalytics.clearCustomContext');
  } else if (method === 'setAuthToken') {
    callInWindow('rudderanalytics.setAuthToken', args[0]);
  }
}

/** Dispatches to the SDK, buffering if it has not finished loading yet. */
function dispatch(method, args) {
  const state = globalState();

  if (state === 'absent') {
    fail(
      'the "' +
        GLOBAL_NAME +
        '" global was not found on this page, so the ' +
        method +
        ' call was not sent. Load the RudderStack JavaScript SDK first, either ' +
        'with a tag that has Call set to load or with the loading snippet.'
    );
    return;
  }

  if (state === 'buffer') {
    bufferCall(method, args);
  } else {
    directCall(method, args);
  }

  data.gtmOnSuccess();
}

/** Call = load. See the LOADER_URL warning above. */
function loadSdk() {
  if (!isFilled(data.writeKey) || !isFilled(data.dataPlaneUrl)) {
    fail('Write key and Data plane URL are both required for the load call.');
    return;
  }

  const args = [data.writeKey, data.dataPlaneUrl];
  if (isObject(data.loadOptions)) {
    args.push(data.loadOptions);
  }

  var state = globalState();
  if (state === 'absent') {
    // overrideExisting stays false so a loading snippet that ran first is
    // never clobbered.
    setInWindow(GLOBAL_NAME, [], false);
    state = 'buffer';
  }

  if (state === 'buffer') {
    bufferCall('load', args);
  } else {
    directCall('load', args);
  }

  // The loader does the feature detection, the method stubs, the globalThis
  // shim and the polyfill branch that the sandbox cannot express, then loads
  // the SDK, which replays the buffered load call.
  injectScript(LOADER_URL, data.gtmOnSuccess, data.gtmOnFailure, LOADER_CACHE_TOKEN);
}

function handlePage() {
  var category = isFilled(data.category) ? data.category : undefined;
  const name = isFilled(data.name) ? data.name : undefined;
  var derived;

  if (category !== undefined && name === undefined) {
    // The SDK declares no overload that takes a category without a name: a lone
    // string argument is reinterpreted as the page name. Fold it into the
    // properties instead, which is where pageArgumentsToCallOptions puts the
    // category anyway.
    log(
      LOG_PREFIX +
        'Category was sent as a page property because Name is empty. Set Name to ' +
        'send it as the page category.'
    );
    derived = { category: category };
    category = undefined;
  }

  const properties = buildProperties(derived);
  const options = buildOptions();

  if (category !== undefined) {
    dispatch('page', truncate([category, name, properties, options]));
  } else if (name !== undefined) {
    dispatch('page', truncate([name, properties, options]));
  } else {
    dispatch('page', truncate([properties, options]));
  }
}

function handleTrack() {
  var event = data.event;
  var derived;

  if (data.useObjectAction === true || data.useObjectAction === 'true') {
    if (!isFilled(data.object) || !isFilled(data.action)) {
      fail('Object and Action are both required when Use object action is True.');
      return;
    }
    event = data.object + ' ' + data.action;
    derived = { category: data.object, object: data.object, action: data.action };
  }

  if (!isFilled(event)) {
    fail('Event is required for the track call.');
    return;
  }

  dispatch('track', truncate([event, buildProperties(derived), buildOptions()]));
}

function handleIdentify() {
  const traits = buildProperties(undefined);
  const options = buildOptions();

  if (isFilled(data.userId)) {
    dispatch('identify', truncate([data.userId, traits, options]));
  } else {
    dispatch('identify', truncate([traits, options]));
  }
}

function handleGroup() {
  const traits = buildProperties(undefined);
  const options = buildOptions();

  if (isFilled(data.groupId)) {
    dispatch('group', truncate([data.groupId, traits, options]));
  } else {
    dispatch('group', truncate([traits, options]));
  }
}

function handleAlias() {
  if (!isFilled(data.to)) {
    fail('To is required for the alias call.');
    return;
  }

  const options = buildOptions();

  if (isFilled(data.from)) {
    dispatch('alias', truncate([data.to, data.from, options]));
  } else {
    dispatch('alias', truncate([data.to, options]));
  }
}

function handleReset() {
  dispatch('reset', [
    {
      entries: {
        userId: data.resetUserId === true,
        userTraits: data.resetUserTraits === true,
        anonymousId: data.resetAnonymousId === true,
        groupId: data.resetGroupId === true,
        groupTraits: data.resetGroupTraits === true,
        initialReferrer: data.resetInitialReferrer === true,
        initialReferringDomain: data.resetInitialReferringDomain === true,
        sessionInfo: data.resetSessionInfo === true,
        authToken: data.resetAuthToken === true
      }
    }
  ]);
}

function handleConsent() {
  if (!isFilled(data.consentOptions)) {
    dispatch('consent', []);
    return;
  }
  if (!isObject(data.consentOptions)) {
    fail('Consent options must be a JSON object variable.');
    return;
  }
  dispatch('consent', [data.consentOptions]);
}

function handleStartSession() {
  if (!isFilled(data.sessionId)) {
    dispatch('startSession', []);
    return;
  }

  const sessionId = makeNumber(data.sessionId);
  if (getType(sessionId) !== 'number' || sessionId !== sessionId) {
    fail('Session id must be a number.');
    return;
  }

  dispatch('startSession', [sessionId]);
}

function handleSetAnonymousId() {
  if (!isFilled(data.anonymousId)) {
    fail('Anonymous id is required for the setAnonymousId call.');
    return;
  }
  dispatch('setAnonymousId', [data.anonymousId]);
}

function handleSetCustomContext() {
  if (!isObject(data.customContext)) {
    fail('Custom context must be a JSON object variable.');
    return;
  }
  dispatch('setCustomContext', [data.customContext]);
}

function handleSetAuthToken() {
  if (!isFilled(data.authToken)) {
    fail('Auth token is required for the setAuthToken call.');
    return;
  }
  dispatch('setAuthToken', [data.authToken]);
}

function main() {
  const call = data.call;

  if (call === 'load') {
    loadSdk();
  } else if (call === 'page') {
    handlePage();
  } else if (call === 'track') {
    handleTrack();
  } else if (call === 'identify') {
    handleIdentify();
  } else if (call === 'group') {
    handleGroup();
  } else if (call === 'alias') {
    handleAlias();
  } else if (call === 'reset') {
    handleReset();
  } else if (call === 'consent') {
    handleConsent();
  } else if (call === 'startSession') {
    handleStartSession();
  } else if (call === 'endSession') {
    dispatch('endSession', []);
  } else if (call === 'setAnonymousId') {
    handleSetAnonymousId();
  } else if (call === 'setCustomContext') {
    handleSetCustomContext();
  } else if (call === 'clearCustomContext') {
    dispatch('clearCustomContext', []);
  } else if (call === 'setAuthToken') {
    handleSetAuthToken();
  } else {
    fail('unsupported Call value "' + call + '". Nothing was sent.');
  }
}

main();


